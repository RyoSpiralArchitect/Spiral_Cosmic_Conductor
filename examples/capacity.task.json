      "id": "workers",
      "kind": "fact",
      "deps": [],
      "source": "current",
      "field": "workers"
    },
    {
      "id": "per_worker",
      "kind": "fact",
      "deps": [],
      "source": "current",
      "field": "per_worker"
    },
    {
      "id": "demand",
      "kind": "fact",
      "deps": [],
      "source": "current",
      "field": "demand"
    },
    {
      "id": "site_name",
      "kind": "fact",
      "deps": [],
